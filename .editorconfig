root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,md}]
indent_size = 2

# Patches must be kept byte-for-byte as generated by git format-patch
[*.patch]
trim_trailing_whitespace = false
insert_final_newline = false
indent_style = unset
indent_size = unset
